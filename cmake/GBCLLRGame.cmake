# Shared source-build entry point for the individual game repositories.
include(CTest)
function(gbcllr_game manifest)
  get_filename_component(engine "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  get_filename_component(game_root "${manifest}" DIRECTORY)
  file(READ "${manifest}" games)
  string(JSON expected_engine GET "${games}" engine_revision)
  find_package(Git REQUIRED)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${engine}" rev-parse HEAD
    OUTPUT_VARIABLE actual_engine OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  option(GBCLLR_ALLOW_DIFFERENT_ENGINE "Develop against an unpinned engine revision" OFF)
  if(NOT actual_engine STREQUAL expected_engine AND NOT GBCLLR_ALLOW_DIFFERENT_ENGINE)
    message(FATAL_ERROR "Check out gbcllr ${expected_engine}; found ${actual_engine}. See games.json")
  endif()
  string(JSON default GET "${games}" default)
  set(GAME "${default}" CACHE STRING "Game variant to build")
  string(JSON title ERROR_VARIABLE invalid GET "${games}" games "${GAME}" title)
  if(invalid)
    message(FATAL_ERROR "Unknown GAME=${GAME}; see games.json for available variants")
  endif()
  foreach(key model sha256 boxart)
    string(JSON ${key} GET "${games}" games "${GAME}" ${key})
  endforeach()
  set(GBCLLR_ROM "" CACHE FILEPATH "Your original, unmodified cartridge")
  set(GBCLLR_BOOT_ROM "" CACHE FILEPATH "Optional matching DMG/CGB boot ROM; also selectable in the launcher")
  if(NOT EXISTS "${GBCLLR_ROM}")
    message(FATAL_ERROR "Set GBCLLR_ROM to your original ${title} cartridge; see games.json for its SHA256")
  endif()
  file(SHA256 "${GBCLLR_ROM}" actual_sha)
  if(NOT actual_sha STREQUAL sha256)
    message(FATAL_ERROR "${title} requires SHA256 ${sha256}; supplied cartridge is ${actual_sha}")
  endif()
  if(GAME STREQUAL "sml2" AND NOT GBCLLR_SML2_COLOR_DATA)
    message(FATAL_ERROR "Set GBCLLR_SML2_COLOR_DATA to the generated native color asset directory; see README.md")
  endif()
  set(game_profile_args)
  if(GAME STREQUAL "sml2")
    set(GBCLLR_AUDIO_SERVICE OPERATION_DMG CACHE STRING "Qualified SML2 audio" FORCE)
    set(GBCLLR_DISPLAY_SERVICE FRAME CACHE STRING "Qualified SML2 picture" FORCE)
    set(GBCLLR_DMG_FRAME ON CACHE BOOL "Qualified stock SML2 picture" FORCE)
    set(GBCLLR_NATIVE_WAIT OFF CACHE BOOL "Qualified SML2 wait profile" FORCE)
    set(GBCLLR_TIMER_SERVICE ELAPSED CACHE STRING "Native SML2 timer" FORCE)
    set(GBCLLR_CABLE_EVENT_HORIZONS ON CACHE BOOL "Qualified SML2 link profile" FORCE)
  endif()
  if(GAME MATCHES "^mm[12]$" AND NOT GBCLLR_MM12_DX_DATA)
    message(FATAL_ERROR "Set GBCLLR_MM12_DX_DATA to the generated native I/II DX assets; see the engine README.md")
  elseif(GAME MATCHES "^mm[34]$" AND NOT GBCLLR_MM34_DX_DATA)
    message(FATAL_ERROR "Set GBCLLR_MM34_DX_DATA to the generated native III/IV DX assets; see the engine README.md")
  elseif(GAME STREQUAL "mm5" AND NOT GBCLLR_MM5_DX_DATA)
    message(FATAL_ERROR "Set GBCLLR_MM5_DX_DATA to the generated native V DX assets; see the engine README.md")
  endif()
  set(GBCLLR_SDL ON CACHE BOOL "Desktop game host" FORCE)
  set(GBCLLR_RECOMP_UI ON CACHE BOOL "Shared GB/GBC launcher and in-game Mods" FORCE)
  option(GBCLLR_NETPLAY "Include the experimental connected-game UI" ON)
  option(GBCLLR_CABLE_BUS_BATCHES "Qualified cable bus scheduling" ON)
  option(GBCLLR_FCONTEXT_CABLE "Qualified portable-fallback cable continuations" ON)
  option(GBCLLR_QUALIFIED_X64_NET "Qualified bounded x64 simulation profile" ON)
  if(GAME STREQUAL "ages" OR GAME STREQUAL "seasons")
    set(GBCLLR_ORACLE_GFX_DATA ON CACHE BOOL "Native Oracle room data" FORCE)
    set(GBCLLR_ORACLE_SHARED_OWNER ON CACHE BOOL "Native Oracle room ownership" FORCE)
  endif()
  find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
  get_filename_component(compiler_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
  add_subdirectory("${engine}" "${CMAKE_CURRENT_BINARY_DIR}/engine")
  add_custom_target(game-launchers ALL
    COMMAND "${Python3_EXECUTABLE}" "${engine}/tools/stage_game.py"
      --runner "$<TARGET_FILE:gbcllr-run>" --rom "${GBCLLR_ROM}"
      --boot-rom "${GBCLLR_BOOT_ROM}" --model "${model}"
      --boxart "${game_root}/${boxart}"
      --compiler-dir "${compiler_dir}"
      ${game_profile_args}
    DEPENDS gbcllr-run
    VERBATIM)
  message(STATUS "${title}: shared GB/GBC recomp-ui, native mods and per-game boxart")
endfunction()
